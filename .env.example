# Copy this file to .env and replace the example domain before starting Compose.
CAMPFIRE_DOMAIN=chat.example.net
# A second DNS name pointing to the same host. LiveKit signaling uses it;
# browser media goes directly to the host ports documented in SELF-HOSTING.md.
CAMPFIRE_MEDIA_DOMAIN=media.example.net
CAMPFIRE_LIVEKIT_API_KEY=campfire-media

# Ten GiB by default. Leave room for SQLite, its WAL, backups, and the host OS.
CAMPFIRE_MAX_STORAGE_BYTES=10737418240
CAMPFIRE_STORAGE_WARNING_PERCENT=90
